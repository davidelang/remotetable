# landlock.config — checked in with @@ tokens; smudge from project.config (manage-configs).
# Machine-specific values come from project.config (especially git_home= absolute path).
# Do NOT put secrets here. Local overrides: edit after checkout or adjust project.config + re-checkout.
#
# project.config (gitignored) on this machine must set e.g.:
#   git_home=/absolute/path/to/git   # NOT ~/git — agent $HOME differs
# Use ABSOLUTE paths.

# Host clone root (absolute after smudge)
git_home=@@GIT_HOME@@

# Default sandbox dirname under worktree (also sandbox_path in project.config)
sandbox_path=@@SANDBOX_PATH@@

# --- profile path lists (filled over time; agent-landlock reads these) ---
# [profile.android]
# Relative to worktree or absolute after smudge:
#   .android-shared
# Runtime env expansions handled by agent-landlock (not smudge):
#   env:HOME/.android
#   env:HOME/.gradle

# host_git_suffix=/.git
# libpin libs discovered at launch from third_party/*/libpin.toml under start worktree
